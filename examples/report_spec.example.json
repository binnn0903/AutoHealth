{
  "title": "AutoML 实验报告（示例）",
  "language": "zh",
  "task_description": "（可选）若不填写，将使用 run_pipeline 的 task_text",
  "primary_metric": "F1",
  "template": {
    "dir": null,
    "main_tex": "main.tex",
    "content_marker": "%%AUTOCLINE:CONTENT%%",
    "placeholders": {
      "TITLE": "AutoML 实验报告（示例）"
    }
  },
  "data": {
    "summary_md": "{task_dir}/agents/data_understanding/report.md",
    "images": [],
    "artifacts": {}
  },
  "iterations": [
    {
      "round": 1,
      "plan_md": "{task_dir}/agents/planning/final_plan.md",
      "result_metrics_json": "{task_dir}/agents/code_execution/metrics.json",
      "feedback_md": "{task_dir}/agents/feedback_reflection/report.md",
      "images": [],
      "artifacts": {}
    }
  ],
  "final_test": {
    "summary_md": "{task_dir}/agents/model_test/report.md",
    "metrics_json": "{task_dir}/agents/model_test/metrics.json",
    "uncertainty_metrics_json": "{task_dir}/agents/model_test/uncertainty_metrics.json",
    "images": [],
    "artifacts": {}
  },
  "extra": {
    "note": "所有路径均支持绝对路径、相对路径（相对 report_spec.json 所在目录），以及 {task_dir}/{{task_dir}} 占位符。"
  }
}

